rules_version = '2';
// Nasij access rules. Roles live in users/{uid}.role: family, volunteer, security.
// Security accounts are made by staff in the Firebase console (users/{uid}.role = 'security').
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function role() { return get(/databases/$(database)/documents/users/$(me())).data.role; }
    function isSecurity() { return signedIn() && role() == 'security'; }
    function isVolunteer() { return signedIn() && role() == 'volunteer'; }
    // A client clock within 5 minutes of the server's
    function nearNow(ms) { return ms > request.time.toMillis() - 300000 && ms < request.time.toMillis() + 300000; }
    function changes(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // A user may pick family or volunteer for themselves, never security.
    // ponytail: volunteer is self-chosen at login; staff-assigned volunteer role is in the "later" list
    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isSecurity());
      allow write: if signedIn() && me() == uid && request.resource.data.role in ['family', 'volunteer'];
    }

    // Members of a family (several per account), health and phone included: the family and security only
    match /members/{id} {
      allow read: if signedIn() && (resource.data.familyId == me() || isSecurity());
      // at = when this family linked it (a real time): passer-by alerts from before it stay hidden from them
      allow create: if signedIn() && request.resource.data.familyId == me()
        && request.resource.data.at is int && nearNow(request.resource.data.at);
      allow update: if signedIn() && resource.data.familyId == me() && request.resource.data.familyId == me()
        && request.resource.data.at is int && nearNow(request.resource.data.at);
      allow delete: if signedIn() && resource.data.familyId == me();
    }

    // Bracelet lock: one family per bracelet per visit
    match /bracelets/{mac} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.familyId == me();
      allow update: if signedIn() && resource.data.familyId == me() && request.resource.data.familyId == me();
      allow delete: if signedIn() && (resource.data.familyId == me() || isSecurity());
    }

    match /reports/{id} {
      function isOwner() { return resource.data.familyId == me(); }
      function isAssigned() { return resource.data.assignedVolunteerId == me(); }

      allow create: if signedIn()
        && request.resource.data.familyId == me()
        && request.resource.data.status == 'open'
        && request.resource.data.assignedVolunteerId == null;
      // Volunteers see open cases (the report holds no health); security sees all
      allow read: if signedIn() && (isOwner() || isSecurity() || (isVolunteer() && resource.data.status != 'closed'));
      allow update: if signedIn() && (
        isSecurity()
        // a volunteer takes an open case for themselves; the transaction makes it first come, first served
        || (isVolunteer() && resource.data.status == 'open'
            && request.resource.data.status == 'searching'
            && request.resource.data.assignedVolunteerId == me()
            && changes(['status', 'assignedVolunteerId', 'acceptedAt'])
            && request.resource.data.acceptedAt is int && nearNow(request.resource.data.acceptedAt))
        // the family or the assigned volunteer closes it. Handing a child to the family ('found') needs the
        // family's handover code: the volunteer sends the typed code in `handover`, and it must name a document
        // in /handover, which the volunteer cannot read. ponytail: 6 digits can be brute-forced by script;
        // a Cloud Function check (Blaze plan) is the better fix, see the brief section 11
        || ((isOwner() || isAssigned()) && request.resource.data.status == 'closed'
            && changes(['status', 'closedAs', 'closedAt', 'photo', 'handover', 'securityPoint'])
            && request.resource.data.get('securityPoint', '') is string && request.resource.data.get('securityPoint', '').size() <= 100
            // a child's report (hasCode) closes only as 'found' with the code, or 'security' (the family is told where)
            && (isOwner() || resource.data.get('hasCode', false) != true
                || request.resource.data.closedAs == 'security'
                || (request.resource.data.closedAs == 'found'
                    && exists(/databases/$(database)/documents/reports/$(id)/handover/$(request.resource.data.handover)))))
      );

      // The handover code, as a document id. The family reads it (to show it after a restart); volunteers never can
      match /handover/{code} {
        function report() { return get(/databases/$(database)/documents/reports/$(id)).data; }
        allow create: if signedIn() && code.size() == 6
          && getAfter(/databases/$(database)/documents/reports/$(id)).data.familyId == me();
        allow read: if signedIn() && report().familyId == me();
        allow delete: if signedIn() && (report().familyId == me() || report().assignedVolunteerId == me() || isSecurity());
      }

      // Health and the family phone: the family, the assigned volunteer and security only
      match /private/{doc} {
        function report() { return get(/databases/$(database)/documents/reports/$(id)).data; }
        // created in the same batch as the report, so read the report as it will be
        allow create: if signedIn() && getAfter(/databases/$(database)/documents/reports/$(id)).data.familyId == me();
        allow read, delete: if signedIn() && (report().familyId == me() || report().assignedVolunteerId == me() || isSecurity());
      }

      // Last sighting for the family: area and time only (volunteer and exact location stay in /sightings)
      // Only the one 'last' document, with a time close to now (a volunteer cannot back- or future-date it)
      match /seen/{doc} {
        function report() { return get(/databases/$(database)/documents/reports/$(id)).data; }
        allow read, delete: if signedIn() && (report().familyId == me() || report().assignedVolunteerId == me() || isSecurity());
        allow create, update: if isVolunteer() && doc == 'last' && report().status != 'closed'
          && request.resource.data.keys().hasOnly(['area', 'at'])
          && request.resource.data.area is string && request.resource.data.area.size() <= 60
          && request.resource.data.at is int && nearNow(request.resource.data.at);
      }
    }

    // Each volunteer writes their own on-duty status and location
    match /volunteers/{uid} {
      allow read: if isSecurity() || (signedIn() && me() == uid);
      // at = time of this write (the hourly cleanup deletes documents an hour old, so it must be the real time)
      allow create, update: if isVolunteer() && me() == uid
        && request.resource.data.at is int && nearNow(request.resource.data.at);
      allow delete: if isVolunteer() && me() == uid;
    }

    // Where a reported bracelet was heard, with the volunteer's location: volunteers and security only
    match /sightings/{id} {
      allow read: if isVolunteer() || isSecurity();
      // Only for a report that is still open, stamped with the volunteer's own id and the current time
      allow create: if isVolunteer() && request.resource.data.volunteerId == me()
        && request.resource.data.reportId is string
        && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.status != 'closed'
        && request.resource.data.at is int && nearNow(request.resource.data.at);
    }

    // Passer-by: no login, can only drop a bracelet number (plus time and location).
    // Only from the sticker: the same batch writes passerbyClaims/{id} with the sticker's secret token.
    // At most 2 per bracelet in 15 minutes: the same batch must move passerbyLimits/{bracelet} to this time.
    match /passerbyReports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['braceletId', 'at', 'location'])
        && existsAfter(/databases/$(database)/documents/passerbyClaims/$(id))
        && request.resource.data.braceletId is string
        && request.resource.data.braceletId.size() == 12
        && request.resource.data.at is int && nearNow(request.resource.data.at)
        && getAfter(/databases/$(database)/documents/passerbyLimits/$(request.resource.data.braceletId)).data.at == request.resource.data.at
        && (!exists(/databases/$(database)/documents/passerbyLimits/$(request.resource.data.braceletId))
            || get(/databases/$(database)/documents/passerbyLimits/$(request.resource.data.braceletId)).data.at != request.resource.data.at);
      allow read: if isVolunteer() || isSecurity();
    }

    // Passer-by count per bracelet: { start, n, at } = window start, reports in it, last report time.
    // Written only together with a report: a new window (n = 1) after 15 minutes, or one more while n < 2.
    // Readable by id so the page knows which of the two to write (it holds no personal data).
    match /passerbyLimits/{bracelet} {
      function next() { return request.resource.data; }
      function newWindow() { return next().n == 1 && next().start == next().at; }
      function valid() {
        return next().keys().hasOnly(['start', 'n', 'at']) && next().at is int && nearNow(next().at);
      }
      allow get: if true;
      allow create: if bracelet.size() == 12 && valid() && newWindow();
      allow update: if valid() && next().at > resource.data.at
        && ((newWindow() && next().at >= resource.data.get('start', 0) + 900000)
            || (next().start == resource.data.get('start', 0) && resource.data.get('n', 0) < 2
                && next().n == resource.data.get('n', 0) + 1));
    }

    // Latest passer-by report per bracelet, for its family to answer "are they with you?".
    // Written only as a copy of a fresh report in the same batch; the family adds the answer.
    match /passerbyAlerts/{bracelet} {
      // The family holding the bracelet now, for alerts sent since they linked it (not an earlier visit's)
      function owner() {
        let lock = get(/databases/$(database)/documents/bracelets/$(bracelet)).data;
        return signedIn() && lock.familyId == me() && (resource == null || resource.data.at >= lock.at);
      }
      function report() { return getAfter(/databases/$(database)/documents/passerbyReports/$(request.resource.data.reportId)).data; }
      allow get: if isSecurity() || owner();
      allow list: if isSecurity();
      allow create, update: if request.resource.data.keys().hasOnly(['at', 'location', 'reportId'])
        && request.resource.data.reportId is string
        && request.resource.data.at is int && nearNow(request.resource.data.at)
        && report().braceletId == bracelet && report().at == request.resource.data.at
        && report().location == request.resource.data.location;
      // Linking a bracelet clears an earlier visit's alert, in the same transaction as the lock
      allow delete: if signedIn() && getAfter(/databases/$(database)/documents/bracelets/$(bracelet)).data.familyId == me();
      allow update: if owner() && changes(['answer', 'answeredAt'])
        && request.resource.data.answer in ['with-me', 'lost']
        && request.resource.data.answeredAt is int && nearNow(request.resource.data.answeredAt);
    }

    // Secret sticker token -> bracelet number. Made by scripts/tokens.mjs (admin), never by the app.
    // Readable one by one with the token (the sticker holds it), never listed, so numbers cannot be guessed.
    match /braceletTokens/{token} {
      allow get: if true;
    }

    // Proof that a passer-by report came from the sticker: the token, next to the report and never readable,
    // so volunteers and security reading reports do not learn tokens
    match /passerbyClaims/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token'])
        && request.resource.data.token is string
        && get(/databases/$(database)/documents/braceletTokens/$(request.resource.data.token)).data.braceletId
           == getAfter(/databases/$(database)/documents/passerbyReports/$(id)).data.braceletId;
    }

    match /zones/{id} {
      allow read: if true;
    }
  }
}
